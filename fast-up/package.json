{
  "name": "fast-up",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "refresh-shell": "node scripts/shell.js --write",
    "demo": "node scripts/launch.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/backup.js restore"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "exceljs": "4.4.0",
    "pg": "8.16.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4"
  }
}
